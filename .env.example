# ==============================================================================
# Sai World Dreams — Environment Variables Template
# Completely Stateless & Database-Free Architecture
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS (comma-separated for multiple allowed origins)
FRONTEND_URL=https://YOUR-WEBSITE-DOMAIN.com

# SMTP Server Credentials (Nodemailer)
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=YOUR_VERIFIED_SENDER_EMAIL

# Owner / Management Email
SAI_WORLD_EMAIL=OFFICIAL_SAI_WORLD_DREAMS_EMAIL

# Integral Web Solution Email (Mandatory)
INTEGRAL_WEB_SOLUTION_EMAIL=princekumarjha80@gmail.com

# Frontend API Base URL (leave blank if using Next.js proxy /api/enquiries)
NEXT_PUBLIC_API_URL=http://localhost:5000
