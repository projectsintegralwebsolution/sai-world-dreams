# ==============================================================================
# Sai World Dreams — Express Backend Environment Configuration Template
# Completely Stateless & Database-Free Architecture
# Copy this file to .env and configure with your production credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Allowed Frontend Origins for CORS (comma-separated)
FRONTEND_URL=http://localhost:3000,http://localhost:3005,https://saiworlddreams.com

# SMTP Server Credentials (e.g. Gmail, SendGrid, Amazon SES, Brevo, Hostinger)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Sai World Dreams <enquiry@saiworlddreams.com>"

# Recipient Email 2: Sai World Dreams Official Owner / Management Email
SAI_WORLD_EMAIL=sheltermauryashelter@gmail.com

# Recipient Email 3: Integral Web Solution Team Email (Mandatory)
INTEGRAL_WEB_SOLUTION_EMAIL=princekumarjha80@gmail.com
